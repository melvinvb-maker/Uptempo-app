rules_version = '2';

// Security rules for the UPTEMPO app (Firestore project uptempo-43116).
// Paste this whole file into Firebase console → Firestore Database → Rules → Publish.
// Everything not matched below is denied. The daily import (scripts/) writes with a
// server key and is not affected by these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ---- Groups: the group code is the key ----
    match /groups/{groupId} {
      function isMember() {
        return signedIn() && exists(/databases/$(database)/documents/groups/$(groupId)/friends/$(request.auth.uid));
      }
      function isCreator() {
        return signedIn() && resource.data.createdBy == request.auth.uid;
      }

      // Opening one group by its exact code is allowed (needed to join);
      // listing all groups is not, so codes cannot be harvested.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && groupId.matches('^UPT-[A-Z0-9-]{4,12}$')
        && request.resource.data.keys().hasOnly(['code', 'createdBy', 'createdAt'])
        && request.resource.data.code == groupId
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;

      // Members: your own document (id = your uid) and people without the app added by a member.
      match /friends/{friendId} {
        function groupExists() {
          return exists(/databases/$(database)/documents/groups/$(groupId));
        }
        function validFriend() {
          let data = request.resource.data;
          return data.keys().hasOnly(['name', 'uid', 'activeAt', 'lastSeen', 'favorites', 'addedBy'])
            && (!('name' in data) || (data.name is string && data.name.size() <= 60))
            && (!('favorites' in data) || (data.favorites is list && data.favorites.size() <= 400))
            && (!('activeAt' in data) || data.activeAt is number);
        }
        function isSelf() {
          return signedIn() && friendId == request.auth.uid;
        }

        allow read: if isMember() || get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid;
        // Joining: you may always write your own membership in an existing group.
        allow create: if groupExists() && validFriend() && (
          (isSelf() && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid))
          || (isMember() && request.resource.data.addedBy == request.auth.uid && !('uid' in request.resource.data))
        );
        allow update: if validFriend() && (
          (isSelf() && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid))
          || (isMember() && resource.data.addedBy == request.auth.uid && request.resource.data.addedBy == request.auth.uid)
        );
        allow delete: if isSelf() || (isMember() && resource.data.addedBy == request.auth.uid);
      }

      // The group's own festival list: members only.
      match /festivals/{festivalId} {
        allow read, write: if isMember();
      }
    }

    // ---- Festival catalogue: read for app users, written only by the server import ----
    match /festivalLineups/{festivalId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ---- Corrections by the owner (custom claim uptempoOwner) ----
    match /editionOverrides/{edition} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.token.uptempoOwner == true;
    }

    // ---- Member profiles (email/password accounts) ----
    match /memberProfiles/{uid} {
      allow get, create, update: if signedIn() && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    // ---- Private chats (unchanged from the existing rules) ----
    match /uptempoChats/{room} {
      function memberAccount() {
        return request.auth != null && request.auth.token.firebase.sign_in_provider == 'password';
      }
      function participant() {
        return memberAccount() && request.auth.uid in resource.data.members;
      }
      allow read: if participant();
      allow create: if memberAccount()
        && request.resource.data.keys().hasOnly(['members','from','state','label'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.state == 'pending'
        && request.resource.data.label is string && request.resource.data.label.size() <= 60
        && request.resource.data.members is list && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] != request.resource.data.members[1]
        && room == request.resource.data.members[0] + ':' + request.resource.data.members[1];
      allow update: if participant() && resource.data.state == 'pending'
        && request.auth.uid != resource.data.from
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state','replyLabel'])
        && request.resource.data.state == 'accepted'
        && request.resource.data.replyLabel is string && request.resource.data.replyLabel.size() <= 60;
      allow delete: if participant() && resource.data.state == 'pending';
      match /messages/{message} {
        function accepted() {
          let chat = get(/databases/$(database)/documents/uptempoChats/$(room)).data;
          return memberAccount() && request.auth.uid in chat.members && chat.state == 'accepted';
        }
        allow read: if accepted();
        allow create: if accepted() && request.resource.data.keys().hasOnly(['text','from','at'])
          && request.resource.data.from == request.auth.uid && request.resource.data.at == request.time
          && request.resource.data.text is string && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
      }
    }
  }
}
